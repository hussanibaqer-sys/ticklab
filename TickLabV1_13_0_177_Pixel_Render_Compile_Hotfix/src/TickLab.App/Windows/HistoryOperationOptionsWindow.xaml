<Window x:Class="TickLab.Desktop.Windows.HistoryOperationOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History operation"
        Width="620" Height="560" MinWidth="560" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" Text="History operation"/>
            <TextBlock x:Name="DescriptionText" Margin="0,5,0,14" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="OptionsPanel"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <CheckBox x:Name="UseStartDateBox" Content="Start from a specific server date" Checked="StartDateToggle_Changed" Unchecked="StartDateToggle_Changed"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Leave off to use all history available for the selected operation." TextWrapping="Wrap"/>
                </StackPanel>
                <TextBox x:Name="StartDateBox" Grid.Column="1" IsEnabled="False" Text="01-01-2022" ToolTip="dd-MM-yyyy"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
            <Button Grid.Column="1" Content="Cancel" Click="CancelButton_Click"/>
            <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="Continue" Click="ContinueButton_Click"/>
        </Grid>
    </Grid>
</Window>
