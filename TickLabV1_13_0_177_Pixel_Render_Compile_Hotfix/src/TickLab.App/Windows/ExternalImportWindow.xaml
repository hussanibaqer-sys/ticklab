<Window x:Class="TickLab.Desktop.Windows.ExternalImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TickLab — Import External History"
        Width="620" Height="560" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource DarkHeaderBrush}">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Import External History" Foreground="White" FontWeight="SemiBold" FontSize="17"/>
                    <TextBlock x:Name="FileNameText" Foreground="#BDBDBD" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="VALIDATE FIRST" Foreground="#8DB2FF" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <TextBlock Text="Dataset name" VerticalAlignment="Center"/>
                <TextBox x:Name="DatasetNameTextBox" Grid.Column="1" Height="36" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="1" Text="Symbol" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="SymbolTextBox" Grid.Row="1" Grid.Column="1" Height="36" Margin="0,10,0,0" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="2" Text="Source / broker" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="SourceTextBox" Grid.Row="2" Grid.Column="1" Height="36" Margin="0,10,0,0" VerticalContentAlignment="Center" Text="External file"/>

                <TextBlock Grid.Row="3" Text="Server UTC offset (min)" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="UtcOffsetTextBox" Grid.Row="3" Grid.Column="1" Height="36" Margin="0,10,0,0" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="4" Text="Whole priority" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="PriorityTextBox" Grid.Row="4" Grid.Column="1" Height="36" Margin="0,10,0,0" VerticalContentAlignment="Center" Text="0"/>

                <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,16,0,0">
                    <CheckBox x:Name="TimeZoneVerifiedCheckBox" Content="The file timezone is known and the offset above is correct"/>
                    <CheckBox x:Name="SourceMatchesBrokerCheckBox" Margin="0,8,0,0" Content="This history comes from the same broker/source as the connected MT5 account"/>
                </StackPanel>

                <Border Grid.Row="6" Grid.ColumnSpan="2" Margin="0,16,0,0" Padding="14" Background="#2A1E0B" BorderBrush="#6A4D18" BorderThickness="1" CornerRadius="8">
                    <TextBlock TextWrapping="Wrap" Foreground="#72521B"
                               Text="TickLab detects M1 OHLC or raw Bid/Ask/Last files from the header. Unknown or corrupt lines are ignored. External history is never labelled as native MT5 unless you confirm the same broker/source."/>
                </Border>

                <TextBlock x:Name="ValidationText" Grid.Row="7" Grid.ColumnSpan="2" Margin="0,14,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>

                <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Width="100" Content="Cancel" Click="CancelButton_Click"/>
                    <Button Style="{StaticResource AccentButton}" Width="130" Margin="0" Content="Import file" Click="ImportButton_Click"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
