<Window x:Class="TickLab.Desktop.Windows.DrawingToolPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320" Height="540" MinWidth="280" MinHeight="400"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Background="{DynamicResource PanelBrush}"
        AllowsTransparency="False" Deactivated="Window_Deactivated">
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="5" Effect="{x:Null}" SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" CornerRadius="4,4,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CategoryIconHost" Width="30" Height="30" CornerRadius="7" Background="{DynamicResource ElevatedBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5"/>
                    </StackPanel>
                    <Button Grid.Column="2" Width="32" Height="32" Padding="0" Margin="0" Content="×" FontSize="18"
                            Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderBrush="Transparent" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="12,12,12,8">
                <TextBox x:Name="SearchBox" Height="38" Padding="36,8,10,8" TextChanged="SearchBox_TextChanged"
                         ToolTip="Search within this drawing category"/>
                <TextBlock Text="⌕" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="18" Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,0,8,4">
                <StackPanel x:Name="ToolRowsPanel"/>
            </ScrollViewer>

            <Border Grid.Row="3" Background="{DynamicResource PanelAltBrush}" CornerRadius="0,0,4,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="FooterText" Margin="13,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5"
                           Text="Enter selects • Esc closes"/>
            </Border>
        </Grid>
    </Border>
</Window>
