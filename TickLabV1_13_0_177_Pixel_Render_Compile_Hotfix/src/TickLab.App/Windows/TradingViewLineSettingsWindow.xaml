<Window x:Class="TickLab.Desktop.Windows.TradingViewLineSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Line settings" Width="372" Height="505" MinWidth="372" MinHeight="505" MaxWidth="372" MaxHeight="505"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="28"/><Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="MinHeight" Value="28"/><Setter Property="FontSize" Value="12"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,3"/><Setter Property="FontSize" Value="12"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,4"/></Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="28"/>
            <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/><Setter Property="BorderBrush" Value="#2962FF"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Padding" Value="9,7"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="RowHeight" Value="30"/><Setter Property="ColumnHeaderHeight" Value="30"/></Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,12,0,6"/></Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{DynamicResource PanelBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Margin="14,0,0,0" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="×" FontSize="18" BorderThickness="0" Background="Transparent" Click="CloseButton_Click"/>
            </Grid>

            <TabControl x:Name="Tabs" Grid.Row="1" Margin="8,0,8,0">
                <TabItem x:Name="StyleTab" Header="Style">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10,8,10,12">
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="PrimaryLineLabel" Text="Line"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="LineColorButton" Width="32" Height="28" Padding="0" Margin="0,0,5,0" Click="LineColorButton_Click" ToolTip="Line color"/>
                                    <ComboBox x:Name="LineStyleBox" Width="72" Margin="0,0,5,0" SelectionChanged="SettingChanged" ToolTip="Line style"/>
                                    <ComboBox x:Name="LineWidthBox" Width="57" Margin="0,0,5,0" SelectionChanged="SettingChanged" ToolTip="Line width"/>
                                    <ToggleButton x:Name="ArrowStartBox" Width="29" Height="28" Margin="0,0,4,0" Content="←" FontSize="13" ToolTip="Start arrow" Checked="SettingChanged" Unchecked="SettingChanged"/>
                                    <ToggleButton x:Name="ArrowEndBox" Width="29" Height="28" Content="→" FontSize="13" ToolTip="End arrow" Checked="SettingChanged" Unchecked="SettingChanged"/>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="GeneralExtendPanel" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Extend"/>
                                <ComboBox x:Name="ExtendBox" Grid.Column="1" SelectionChanged="SettingChanged"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Transparent → Solid"/>
                                <Slider x:Name="LineOpacitySlider" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" ValueChanged="LineOpacitySlider_ValueChanged"/>
                                <TextBlock x:Name="LineOpacityValueText" Grid.Column="2" HorizontalAlignment="Right" Text="0%"/>
                            </Grid>
                            <Grid x:Name="FillOpacityPanel" Margin="0,0,0,5" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Fill: Transparent → Solid" FontSize="10.5"/>
                                <Slider x:Name="FillOpacitySlider" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" ValueChanged="FillOpacitySlider_ValueChanged"/>
                                <TextBlock x:Name="FillOpacityValueText" Grid.Column="2" HorizontalAlignment="Right" Text="0%"/>
                            </Grid>
                            <StackPanel Margin="96,0,0,0">
                                <CheckBox x:Name="MiddlePointBox" Content="Middle point" Checked="SettingChanged" Unchecked="SettingChanged"/>
                                <CheckBox x:Name="PriceLabelsBox" Content="Price labels" Checked="SettingChanged" Unchecked="SettingChanged"/>
                                <CheckBox x:Name="PlaceAsBackgroundBox" Content="Place as background (behind candles)" Checked="SettingChanged" Unchecked="SettingChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="ChannelSection" Visibility="Collapsed">
                                <TextBlock Text="CHANNEL LEVELS" Style="{StaticResource SectionLabel}"/>
                                <CheckBox x:Name="MiddleLineBox" Content="Legacy middle line" Visibility="Collapsed" Checked="SettingChanged" Unchecked="SettingChanged"/>
                                <DataGrid x:Name="ChannelLevelsGrid" Height="162" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="SettingChanged">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="42"/>
                                        <DataGridTextColumn Header="Level" Binding="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Width="68"/>
                                        <DataGridTextColumn Header="Color" Binding="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTextColumn Header="Width" Binding="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" Width="56"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <CheckBox x:Name="BackgroundBox" Content="Background" Margin="0,6,0,0" Checked="SettingChanged" Unchecked="SettingChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="RegressionSection" Visibility="Collapsed">
                                <TextBlock Text="REGRESSION TREND" Style="{StaticResource SectionLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                                    <TextBlock Text="Upper deviation"/><TextBox x:Name="UpperDeviationBox" Grid.Column="1" TextChanged="TextSettingChanged"/>
                                    <TextBlock Grid.Row="1" Text="Lower deviation"/><TextBox x:Name="LowerDeviationBox" Grid.Row="1" Grid.Column="1" TextChanged="TextSettingChanged"/>
                                    <TextBlock Grid.Row="2" Text="Source"/><ComboBox x:Name="RegressionSourceBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" SelectionChanged="SettingChanged"/>
                                </Grid>
                                <CheckBox x:Name="PearsonsRBox" Content="Pearson's R" Checked="SettingChanged" Unchecked="SettingChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="PitchforkSection" Visibility="Collapsed">
                                <TextBlock Text="PITCHFORK" Style="{StaticResource SectionLabel}"/>
                                <CheckBox x:Name="PitchforkExtendBox" Content="Extend lines" Margin="0,0,0,6" Checked="SettingChanged" Unchecked="SettingChanged"/>
                                <TextBlock Text="Levels" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,5"/>
                                <DataGrid x:Name="LevelsGrid" Height="286" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="SettingChanged">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="40"/>
                                        <DataGridTextColumn Header="Level" Binding="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Width="62"/>
                                        <DataGridTemplateColumn Header="Color" Width="62">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Width="40" Height="22" Padding="0" Margin="3,1" Background="{Binding Color}" Tag="{Binding}" Click="PitchforkLevelColorButton_Click" ToolTip="Level color"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Width" Binding="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" Width="54"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <CheckBox x:Name="PitchforkUseOneColorBox" Content="Use one color" Margin="0,6,0,0" Checked="SettingChanged" Unchecked="SettingChanged"/>
                                <CheckBox x:Name="PitchforkBackgroundBox" Content="Background" Checked="SettingChanged" Unchecked="SettingChanged"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Style"/>
                                    <ComboBox x:Name="PitchforkStyleBox" Grid.Column="1" SelectionChanged="SettingChanged"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="InfoSection">
                                <TextBlock Text="INFO" Style="{StaticResource SectionLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                                    <TextBlock Text="Stats"/><ComboBox x:Name="StatsBox" Grid.Column="1" SelectionChanged="SettingChanged"/>
                                    <TextBlock Grid.Row="1" Text="Stats position"/><ComboBox x:Name="StatsPositionBox" Grid.Row="1" Grid.Column="1" SelectionChanged="SettingChanged"/>
                                </Grid>
                                <CheckBox x:Name="AlwaysStatsBox" Content="Always show stats" Margin="96,4,0,4" Checked="SettingChanged" Unchecked="SettingChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TextTab" Header="Text">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/></Grid.RowDefinitions>
                        <TextBlock Text="Text" VerticalAlignment="Top" Margin="0,7,0,0"/>
                        <TextBox x:Name="DrawingTextBox" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="TextSettingChanged"/>
                        <TextBlock Grid.Row="1" Text="Color"/><Button x:Name="TextColorButton" Grid.Row="1" Grid.Column="1" Width="38" HorizontalAlignment="Left" Click="TextColorButton_Click"/>
                        <TextBlock Grid.Row="2" Text="Size"/><ComboBox x:Name="FontSizeBox" Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left" SelectionChanged="SettingChanged"/>
                        <WrapPanel Grid.Row="3" Grid.Column="1"><CheckBox x:Name="BoldBox" Content="Bold" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="ItalicBox" Content="Italic" Margin="18,4,0,4" Checked="SettingChanged" Unchecked="SettingChanged"/></WrapPanel>
                    </Grid>
                </TabItem>

                <TabItem x:Name="CoordinatesTab" Header="Coordinates">
                    <StackPanel Margin="10,12,10,10">
                        <DataGrid x:Name="CoordinatesGrid" Height="176" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="None" GridLinesVisibility="None" BorderThickness="0" RowHeight="38" SelectionChanged="SettingChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding LabelText}" IsReadOnly="True" Width="112"/>
                                <DataGridTextColumn Binding="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Binding="{Binding BarText, UpdateSourceTrigger=PropertyChanged}" Width="82"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid x:Name="AnglePanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Angle"/><TextBox x:Name="AngleBox" Grid.Column="1" TextChanged="TextSettingChanged"/><TextBlock Grid.Column="2" Text="°" Margin="5,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <TabItem x:Name="VisibilityTab" Header="Visibility">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14">
                        <TextBlock Text="Visible on intervals" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <CheckBox x:Name="TicksBox" Content="Ticks" Checked="SettingChanged" Unchecked="SettingChanged"/>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><CheckBox x:Name="SecondsBox" Content="Seconds" Checked="SettingChanged" Unchecked="SettingChanged"/><TextBox x:Name="SecondsMinBox" Grid.Column="1" Text="1" Margin="0,0,6,0" TextChanged="TextSettingChanged"/><Slider x:Name="SecondsMaxSlider" Grid.Column="2" Minimum="1" Maximum="59" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="VisibilityRangeSlider_ValueChanged"/><TextBlock x:Name="SecondsMaxText" Grid.Column="3" HorizontalAlignment="Right"/></Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><CheckBox x:Name="MinutesBox" Content="Minutes" Checked="SettingChanged" Unchecked="SettingChanged"/><TextBox x:Name="MinutesMinBox" Grid.Column="1" Text="1" Margin="0,0,6,0" TextChanged="TextSettingChanged"/><Slider x:Name="MinutesMaxSlider" Grid.Column="2" Minimum="1" Maximum="59" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="VisibilityRangeSlider_ValueChanged"/><TextBlock x:Name="MinutesMaxText" Grid.Column="3" HorizontalAlignment="Right"/></Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><CheckBox x:Name="HoursBox" Content="Hours" Checked="SettingChanged" Unchecked="SettingChanged"/><TextBox x:Name="HoursMinBox" Grid.Column="1" Text="1" Margin="0,0,6,0" TextChanged="TextSettingChanged"/><Slider x:Name="HoursMaxSlider" Grid.Column="2" Minimum="1" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="VisibilityRangeSlider_ValueChanged"/><TextBlock x:Name="HoursMaxText" Grid.Column="3" HorizontalAlignment="Right"/></Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><CheckBox x:Name="DailyBox" Content="Days" Checked="SettingChanged" Unchecked="SettingChanged"/><TextBox x:Name="DailyMinBox" Grid.Column="1" Text="1" Margin="0,0,6,0" TextChanged="TextSettingChanged"/><Slider x:Name="DailyMaxSlider" Grid.Column="2" Minimum="1" Maximum="366" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="VisibilityRangeSlider_ValueChanged"/><TextBlock x:Name="DailyMaxText" Grid.Column="3" HorizontalAlignment="Right"/></Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><CheckBox x:Name="WeeklyBox" Content="Weeks" Checked="SettingChanged" Unchecked="SettingChanged"/><TextBox x:Name="WeeklyMinBox" Grid.Column="1" Text="1" Margin="0,0,6,0" TextChanged="TextSettingChanged"/><Slider x:Name="WeeklyMaxSlider" Grid.Column="2" Minimum="1" Maximum="52" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="VisibilityRangeSlider_ValueChanged"/><TextBlock x:Name="WeeklyMaxText" Grid.Column="3" HorizontalAlignment="Right"/></Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><CheckBox x:Name="MonthlyBox" Content="Months" Checked="SettingChanged" Unchecked="SettingChanged"/><TextBox x:Name="MonthlyMinBox" Grid.Column="1" Text="1" Margin="0,0,6,0" TextChanged="TextSettingChanged"/><Slider x:Name="MonthlyMaxSlider" Grid.Column="2" Minimum="1" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="VisibilityRangeSlider_ValueChanged"/><TextBlock x:Name="MonthlyMaxText" Grid.Column="3" HorizontalAlignment="Right"/></Grid>
                        <CheckBox x:Name="RangesBox" Content="Ranges" Margin="0,7,0,0" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2" Margin="10,4,10,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="TemplateBox" Width="150" HorizontalAlignment="Left" ToolTip="Template" SelectionChanged="TemplateBox_SelectionChanged"/>
                <Button Grid.Column="1" Content="Cancel" Width="72" Margin="0,0,7,0" Click="CancelButton_Click"/>
                <Button Grid.Column="2" Content="Ok" Width="54" Background="#1F2329" Foreground="White" BorderBrush="#1F2329" Click="OkButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
