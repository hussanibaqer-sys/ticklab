<Window x:Class="TickLab.Desktop.Windows.DrawingImagePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image" Width="410" Height="315" MinWidth="410" MinHeight="315" MaxWidth="410" MaxHeight="315"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource WindowBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <!-- TradingView-style choose/preview well.  The helper text stays in the
             same location until a local image has been decoded. -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1" CornerRadius="5" Padding="10">
            <Grid>
                <StackPanel x:Name="ChooseImagePrompt" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="ChooseImageButton" Content="Choose image" MinWidth="104" Height="31" MinHeight="31"
                            Padding="12,4" HorizontalAlignment="Center" Click="ChooseImageButton_Click"/>
                    <TextBlock Text="JPG, PNG or WEBP" Margin="0,9,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5"/>
                    <TextBlock Text="MAX SIZE 2 MB" Margin="0,2,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5"/>
                </StackPanel>
                <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" Margin="4"/>
                <Border x:Name="LoadingOverlay" Visibility="Collapsed" Background="#88000000" CornerRadius="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="92" Height="5" IsIndeterminate="True"/>
                        <TextBlock Text="Loading image…" Margin="0,8,0,0" Foreground="White" FontSize="10.5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button x:Name="ReplaceImageButton" Content="Change image" Width="94" Height="28" MinHeight="28"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Visibility="Collapsed"
                        Click="ChooseImageButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="1,5,1,3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
            <TextBlock Text="Transparency" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0"/>
            <Slider Grid.Column="1" x:Name="TransparencySlider" Minimum="0" Maximum="100" Value="0" TickFrequency="1"
                    VerticalAlignment="Center" ValueChanged="TransparencySlider_ValueChanged"/>
            <TextBlock Grid.Column="2" x:Name="TransparencyValueText" Text="0%" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Foreground="{DynamicResource MutedTextBrush}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,3,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectedFileText" Text="" Foreground="{DynamicResource MutedTextBrush}" FontSize="9.5"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,10,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="70" Height="30" MinHeight="30" Margin="0,0,7,0" Click="CancelButton_Click"/>
                <Button x:Name="OkButton" Content="OK" MinWidth="52" Height="30" MinHeight="30" IsEnabled="False" Click="OkButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
