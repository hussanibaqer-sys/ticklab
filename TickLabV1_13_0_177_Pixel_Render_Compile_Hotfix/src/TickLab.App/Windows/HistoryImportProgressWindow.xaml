<Window x:Class="TickLab.Desktop.Windows.HistoryImportProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TickLab History Import"
        Width="590"
        Height="760"
        MinWidth="550"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#0B0B0B"
        Foreground="#F4F7FB"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="BorderBrush" Value="#353535"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#7F1D1D"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MT5 HISTORY IMPORT" Foreground="#60A5FA" FontSize="12" FontWeight="Bold"/>
                <TextBlock x:Name="TitleText" Text="Preparing native candle history" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBlock x:Name="SubtitleText" Foreground="#94A3B8" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Minimize" Click="MinimizeButton_Click" VerticalAlignment="Top"/>
        </Grid>

        <Border Grid.Row="1" Margin="0,20,0,0" Padding="16" Background="#151515" BorderBrush="#333333" BorderThickness="1" CornerRadius="10">
            <StackPanel>
                <Grid>
                    <TextBlock Text="Overall progress" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OverallProgressText" Text="0.0%" HorizontalAlignment="Right" Foreground="#93C5FD" FontWeight="Bold"/>
                </Grid>
                <ProgressBar x:Name="OverallProgressBar" Minimum="0" Maximum="100" Value="0" Margin="0,10,0,0"/>
                <TextBlock x:Name="CompletedTimeframesText" Text="Completed: none" Foreground="#94A3B8" FontSize="12" Margin="0,9,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="0,14,0,0" Padding="18" Background="#151515" BorderBrush="#333333" BorderThickness="1" CornerRadius="10">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="CURRENT TIMEFRAME" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="CurrentTimeframeText" Text="Scanning…" FontSize="30" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock x:Name="CurrentPercentText" Text="0.0%" FontSize="25" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="CurrentStatusText" Text="Preparing" Foreground="#A7F3D0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="1. Import from MT5" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"/>
                <ProgressBar x:Name="CurrentProgressBar" Minimum="0" Maximum="100" Value="0" Margin="0,7,0,0"/>

                <Grid Margin="0,17,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Current date" Foreground="#94A3B8" Margin="0,0,12,9"/>
                    <TextBlock x:Name="CurrentDateText" Grid.Row="0" Grid.Column="1" Text="—" FontWeight="SemiBold" Margin="0,0,22,9"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Speed" Foreground="#94A3B8" Margin="0,0,12,9"/>
                    <TextBlock x:Name="SpeedText" Grid.Row="0" Grid.Column="3" Text="—" FontWeight="SemiBold" Margin="0,0,0,9"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Candles" Foreground="#94A3B8" Margin="0,0,12,9"/>
                    <TextBlock x:Name="CandleCountText" Grid.Row="1" Grid.Column="1" Text="0" FontWeight="SemiBold" Margin="0,0,22,9"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Elapsed" Foreground="#94A3B8" Margin="0,0,12,9"/>
                    <TextBlock x:Name="ElapsedText" Grid.Row="1" Grid.Column="3" Text="00:00:00" FontWeight="SemiBold" Margin="0,0,0,9"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Block" Foreground="#94A3B8" Margin="0,0,12,0"/>
                    <TextBlock x:Name="BlockText" Grid.Row="2" Grid.Column="1" Text="—" FontWeight="SemiBold" Margin="0,0,22,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Retries" Foreground="#94A3B8" Margin="0,0,12,0"/>
                    <TextBlock x:Name="RetryText" Grid.Row="2" Grid.Column="3" Text="0" FontWeight="SemiBold"/>
                </Grid>
                <Border Margin="0,15,0,0" Padding="10" Background="#0B1424" BorderBrush="#333333" BorderThickness="1" CornerRadius="6">
                    <TextBlock x:Name="NativeCoverageText" Text="Native MT5 range: discovering…" Foreground="#C4B5FD" FontSize="12"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,14,0,0" Padding="16" Background="#102419" BorderBrush="#245C3A" BorderThickness="1" CornerRadius="10">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="2. SAVE → VERIFY → COMMIT → CHART LOAD" Foreground="#86EFAC" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="ChartLaunchStatusText" Text="Waiting for MT5 import" Foreground="#D1FAE5" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="ChartLaunchPercentText" Text="0.0%" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="#4ADE80"/>
                </Grid>
                <ProgressBar x:Name="ChartLaunchProgressBar" Minimum="0" Maximum="100" Value="0" Margin="0,10,0,0" Foreground="#22C55E"/>
                <TextBlock x:Name="ChartLaunchDetailText" Text="Saved history releases the import queue first. The same main chart loads separately; no extra chart window is created." Foreground="#A7F3D0" FontSize="12" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Margin="0,14,0,14" Padding="15" Background="#0D0D0D" BorderBrush="#333333" BorderThickness="1" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="STATUS" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="MessageText" Text="TickLab is preparing the import." Margin="0,7,0,0" LineHeight="20"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="QuickRefreshButton" Style="{StaticResource PrimaryButton}" Content="Retry Current Stage" Click="QuickRefreshButton_Click"/>
                <Button x:Name="RetryChartLaunchButton" Style="{StaticResource SecondaryButton}" Content="Retry Chart Launch" Click="RetryChartLaunchButton_Click" IsEnabled="False"/>
                <Button x:Name="PauseButton" Style="{StaticResource SecondaryButton}" Content="Pause" Click="PauseButton_Click"/>
                <Button x:Name="RestartAllButton" Style="{StaticResource DangerButton}" Content="Restart All Import" Click="RestartAllButton_Click"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Copy Diagnostics" Click="CopyDiagnosticsButton_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CompletionButton" Style="{StaticResource PrimaryButton}" Content="OK" Visibility="Collapsed" Click="CompletionButton_Click"/>
                <Button x:Name="HideButton" Style="{StaticResource SecondaryButton}" Content="Hide" Click="HideButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
