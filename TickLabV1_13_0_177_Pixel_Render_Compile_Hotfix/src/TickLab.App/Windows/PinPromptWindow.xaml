<Window x:Class="TickLab.Desktop.Windows.PinPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm deletion"
        Width="420" Height="245"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Protected delete" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,6" Text="The selected saved history will be permanently deleted:" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
        <Border Grid.Row="2" Padding="8" Background="#18202B" CornerRadius="4">
            <TextBlock x:Name="TargetText" TextWrapping="Wrap" Foreground="White" FontSize="11"/>
        </Border>
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Enter safety PIN 159:" Foreground="{StaticResource MutedTextBrush}"/>
            <PasswordBox x:Name="PinBox" Height="34" Margin="0,5,0,0" MaxLength="12" VerticalContentAlignment="Center" KeyDown="PinBox_KeyDown"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Width="90" Content="Cancel" Click="CancelButton_Click"/>
            <Button Width="90" Margin="8,0,0,0" Style="{StaticResource DangerButton}" Content="Delete" Click="DeleteButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
