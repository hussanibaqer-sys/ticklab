<Window x:Class="TickLab.Desktop.Windows.TickScriptEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TickLab Script Editor — TickScript 1.1"
        Width="1120"
        Height="760"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#080808"
        Foreground="#E8EEF8"
        ShowInTaskbar="False"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="#172338"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#40516A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0C1728"/>
            <Setter Property="Foreground" Value="#E8EEF8"/>
            <Setter Property="BorderBrush" Value="#35445B"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#708097"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#0C0C0C"/>
            <Setter Property="Foreground" Value="#E8EEF8"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0C0C0C"/>
            <Setter Property="Foreground" Value="#E8EEF8"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="RowBackground" Value="#0C0C0C"/>
            <Setter Property="AlternatingRowBackground" Value="#101D30"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#343434"/>
            <Setter Property="VerticalGridLinesBrush" Value="#343434"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="#C5D2E5"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#E8EEF8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#141414" BorderBrush="#2D3E56" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="New Indicator" Click="NewIndicatorButton_Click"/>
                <Button Grid.Column="1" Content="New EA" Click="NewEaButton_Click"/>
                <Button Grid.Column="2" Content="New selected type" Click="NewScriptButton_Click"/>
                <Button Grid.Column="3" Content="Compile &amp; Save" Background="#2458D6" BorderBrush="#4E7EFF" Click="CompileButton_Click"/>
                <Button Grid.Column="4" Content="Delete" Background="#4B1E29" BorderBrush="#8B3B4F" Click="DeleteButton_Click"/>
                <Button Grid.Column="5" Content="Open Folder" Click="OpenFolderButton_Click"/>
                <Button Grid.Column="6" Content="Help / Examples" Click="HelpButton_Click"/>

                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="CompileDot" Width="9" Height="9" Fill="#64748B" Margin="0,0,8,0"/>
                    <TextBlock x:Name="HeaderStatusText" Text="Ready" Foreground="#B9C7DA" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0C0C0C" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="12,11,12,8">
                        <TextBlock Text="My TickLab scripts" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Indicators, EAs, strategies, scanners, alerts and tools" Foreground="#A8A8A8" Margin="0,3,0,0"/>
                    </StackPanel>

                    <ListBox x:Name="ScriptList"
                             Grid.Row="1"
                             BorderThickness="0,1,0,1"
                             SelectionChanged="ScriptList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="9,7" BorderBrush="#223149" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding TypeText}" Foreground="#8DB2FF"/>
                                            <TextBlock Text="  •  " Foreground="#677992"/>
                                            <TextBlock Text="{Binding StatusText}" Foreground="#A8B7C9"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="ScriptCountText"
                               Grid.Row="2"
                               Margin="12,9"
                               Foreground="#A8A8A8"
                               Text="0 scripts"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="185"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#141414" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Script name" Foreground="#AAB9CC"/>
                            <TextBox x:Name="NameBox" Margin="0,4,0,0" TextChanged="Metadata_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Script type" Foreground="#AAB9CC"/>
                            <ComboBox x:Name="KindBox" Margin="0,4,0,0" SelectionChanged="Metadata_Changed" DisplayMemberPath="Label"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="0,8,0,8" Background="#070707" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#141414" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0">
                            <Grid Margin="9,0">
                                <TextBlock Text="TickScript source" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CursorText" Text="Ln 1, Col 1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#A8A8A8"/>
                            </Grid>
                        </Border>
                        <TextBox x:Name="CodeEditor"
                                 Grid.Row="1"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 SpellCheck.IsEnabled="False"
                                 SelectionChanged="CodeEditor_SelectionChanged"
                                 TextChanged="CodeEditor_TextChanged"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#0C0C0C" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="31"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#141414" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0">
                            <Grid Margin="9,0">
                                <TextBlock Text="Compiler output" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock Text="Double-click an error to go to its line" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#A8A8A8"/>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="DiagnosticsGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  MouseDoubleClick="DiagnosticsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Level" Binding="{Binding Severity}" Width="80"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="105"/>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="82"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#0E192A" BorderBrush="#2D3E56" BorderThickness="0,1,0,0">
            <Grid Margin="11,0">
                <TextBlock x:Name="FooterStatusText" Text="F5 or Ctrl+S: compile and save" Foreground="#A9B8CB" VerticalAlignment="Center"/>
                <TextBlock Text="TickScript 1.1 • EAs are simulation/backtesting only" HorizontalAlignment="Right" Foreground="#7F91AA" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
