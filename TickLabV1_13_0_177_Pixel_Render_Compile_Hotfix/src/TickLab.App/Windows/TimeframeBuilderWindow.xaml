<Window x:Class="TickLab.Desktop.Windows.TimeframeBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TickLab — Make timeframe"
        Width="440"
        Height="310"
        MinWidth="440"
        MinHeight="310"
        MaxWidth="540"
        MaxHeight="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}">
    <Window.Resources>
        <Style x:Key="TimeframeInputTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionTextBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style x:Key="TimeframeUnitItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimeframeUnitComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource TimeframeUnitItem}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource DarkHeaderBrush}">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="29" Height="29" CornerRadius="8" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock Text="T" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="Make timeframe" Foreground="White" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="18" Padding="18" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Create a custom timeframe" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Choose a number and unit. Custom timeframes can be removed later."/>
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Number" Margin="0,0,0,6" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox x:Name="QuantityTextBox" Text="7" FontSize="16"
                                 Style="{StaticResource TimeframeInputTextBox}"
                                 PreviewTextInput="QuantityTextBox_PreviewTextInput"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Unit" Margin="0,0,0,6" Foreground="{StaticResource MutedTextBrush}"/>
                        <ComboBox x:Name="UnitComboBox" FontSize="15" SelectedIndex="1"
                                  Style="{StaticResource TimeframeUnitComboBox}">
                            <ComboBoxItem Content="Seconds" Tag="Second"/><ComboBoxItem Content="Minutes" Tag="Minute"/>
                            <ComboBoxItem Content="Hours" Tag="Hour"/><ComboBoxItem Content="Days" Tag="Day"/>
                            <ComboBoxItem Content="Weeks" Tag="Week"/><ComboBoxItem Content="Months" Tag="Month"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ValidationText" Grid.Row="4" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" MinWidth="92" Height="34" Margin="0,0,8,0"/>
                    <Button Content="Make Timeframe" Style="{StaticResource AccentButton}"
                            MinWidth="132" Height="34" Margin="0"
                            IsDefault="True" Click="GenerateButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
