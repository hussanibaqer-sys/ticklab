<Window x:Class="TickLab.Desktop.Windows.TickHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TickLab — Tick History"
        Width="1120" Height="720" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource DarkHeaderBrush}">
            <Grid Margin="18,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Tick History" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Permanent raw ticks — quarter folders; Actual From/To shows real stored tick coverage" Foreground="#BDBDBD" FontSize="11"/>
                </StackPanel>
                <TextBlock x:Name="ConnectorText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8DB2FF"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Saved instrument folders" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <ListBox x:Name="SymbolsList" Grid.Row="1" SelectionChanged="SymbolsList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="SymbolItem_PreviewMouseRightButtonDown"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" Margin="2,3">
                                    <CheckBox DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"
                                              IsThreeState="True" IsChecked="{Binding IsVisible}"
                                              Tag="{Binding Symbol}" Click="SymbolVisibilityCheckBox_Click"
                                              ToolTip="Checked: use saved tick folders. Unchecked: keep ticks but hide them from charts."/>
                                    <TextBlock Text="{Binding Symbol}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open folder" Click="OpenSymbolFolder_Click"/>
                                <MenuItem Header="Copy folder" Click="CopySymbolFolder_Click"/>
                                <MenuItem Header="Copy path" Click="CopySymbolPath_Click"/>
                                <Separator/>
                                <MenuItem Header="Delete all tick folders" Click="DeleteSymbolFolder_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Content="Select All" Margin="0,0,4,0" Click="ShowAllSymbols_Click"/>
                        <Button Grid.Column="1" Content="Hide All" Margin="4,0,0,0" Click="HideAllSymbols_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="FolderTitle" Text="Select an instrument" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="FolderPathText" Margin="0,4,0,10" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Width="120" Height="36" Margin="0,0,8,0" Content="Open Folder" Click="OpenFolderButton_Click"/>
                        <Button Grid.Column="2" Width="160" Height="36" Style="{StaticResource AccentButton}" Content="Refresh Tick Data" Click="RefreshTicksButton_Click"/>
                        <Button Grid.Column="3" Width="190" Height="36" Margin="8,0,0,0" Style="{StaticResource SoftAccentButton}" Content="Build Candles from Ticks" Click="BuildCandlesButton_Click"/>
                    </Grid>

                    <DataGrid x:Name="SegmentsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False"
                              RowHeaderWidth="0" SelectionMode="Single" CanUserAddRows="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="SegmentRow_PreviewMouseRightButtonDown"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open folder" Click="OpenSelectedFolder_Click"/>
                                <MenuItem Header="Copy folder" Click="CopyFolder_Click"/>
                                <MenuItem Header="Copy path" Click="CopyPath_Click"/>
                                <Separator/>
                                <MenuItem Header="Delete" Click="DeleteFolder_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Display" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsVisible}" Tag="{Binding SegmentKey}"
                                                  Click="SegmentVisibilityCheckBox_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Three-month folder" Binding="{Binding SegmentKey}" Width="220" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Actual From" Binding="{Binding From}" Width="135" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Actual To" Binding="{Binding To}" Width="135" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}"
                               Text="Unchecked folders remain on disk and create an empty time gap at their real location on tick/second charts."/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="22,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Tick refresh compares broker timestamp, milliseconds, Bid, Ask, Last, volume and flags where MT5 still provides the range."/>
            <Button Grid.Column="1" Width="100" Content="Back" Click="BackButton_Click"/>
            <Button Grid.Column="2" Width="100" Margin="8,0,0,0" Content="Close" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
