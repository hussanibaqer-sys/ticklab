<Window x:Class="TickLab.Desktop.Windows.DrawingSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:TickLab.Desktop.Settings"
        Title="Drawing Settings" Width="560" Height="625" MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="CompactButton" TargetType="Button">
            <Setter Property="MinHeight" Value="29"/><Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <settings:ColorValueToBrushConverter x:Key="ColorValueToBrushConverter"/>
        <settings:ColorValueToNameConverter x:Key="ColorValueToNameConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="13,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToolTypeText" Grid.Column="1" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Reference-style settings pages.  Advanced TickLab metadata is kept in a compact
             expander instead of occupying permanent tabs. -->
        <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="7" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}">
            <TabItem x:Name="StyleTab" Header="Style">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="13">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="LineLabel" Grid.Row="0" Text="Line" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                <TextBox x:Name="LineColorBox" Visibility="Collapsed"/><Button x:Name="LineColorButton" settings:ThemeColorScope.PreserveExactColors="True" Width="38" Height="29" MinHeight="29" Margin="0,0,6,0" Click="LineColorButton_Click" ToolTip="Line colour"/>
                                <ComboBox x:Name="LineStyleBox" Width="104" Height="29" MinHeight="29" Margin="0,0,6,0"/>
                                <TextBox x:Name="LineWidthBox" Width="56" Height="29" Padding="7,4" ToolTip="Line width in pixels"/>
                            </StackPanel>

                            <TextBlock x:Name="FillColorLabel" Grid.Row="1" Text="Background" VerticalAlignment="Center"/>
                            <StackPanel x:Name="FillColorEditor" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                <TextBox x:Name="FillColorBox" Visibility="Collapsed"/>
                                <Button x:Name="FillColorButton" settings:ThemeColorScope.PreserveExactColors="True" Width="38" Height="29" MinHeight="29" Margin="0,0,8,0" Click="FillColorButton_Click" ToolTip="Fill colour"/>
                                <CheckBox x:Name="FillEnabledBox" Content="Background" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </StackPanel>

                            <TextBlock x:Name="TextColorLabel" Grid.Row="2" Text="Text colour" VerticalAlignment="Center"/>
                            <Grid x:Name="TextColorEditor" Grid.Row="2" Grid.Column="1" Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="0"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="TextColorBox" Visibility="Collapsed"/><Button x:Name="TextColorButton" settings:ThemeColorScope.PreserveExactColors="True" Grid.Column="1" Height="29" MinHeight="29" Click="TextColorButton_Click" ToolTip="Text colour"/>
                            </Grid>

                            <TextBlock Grid.Row="3" Text="Transparent → solid" VerticalAlignment="Center"/>
                            <Grid Grid.Row="3" Grid.Column="1" Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05" VerticalAlignment="Center"/>
                                <TextBox x:Name="OpacityBox" Grid.Column="1" Margin="7,0,0,0" Padding="7,4"/>
                            </Grid>

                            <TextBlock x:Name="FillOpacityLabel" Grid.Row="4" Text="Fill: transparent → solid" VerticalAlignment="Center"/>
                            <Grid x:Name="FillOpacityEditor" Grid.Row="4" Grid.Column="1" Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                <Slider x:Name="FillOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05" VerticalAlignment="Center"/>
                                <TextBox x:Name="FillOpacityBox" Grid.Column="1" Margin="7,0,0,0" Padding="7,4"/>
                            </Grid>

                            <WrapPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,2">
                                <CheckBox x:Name="ExtendLeftBox" Content="Extend left" Margin="0,0,15,6"/>
                                <CheckBox x:Name="ExtendRightBox" Content="Extend right" Margin="0,0,15,6"/>
                                <CheckBox x:Name="MiddleLineBox" Content="Middle line" Margin="0,0,15,6"/>
                                <CheckBox x:Name="MiddlePointBox" Content="Middle point" Margin="0,0,15,6"/>
                                <CheckBox x:Name="PriceLabelsBox" Content="Price labels" Margin="0,0,15,6"/>
                                <CheckBox x:Name="TimeLabelsBox" Content="Time labels" Margin="0,0,15,6"/>
                                <CheckBox x:Name="ArrowStartBox" Content="Arrow start" Margin="0,0,15,6"/>
                                <CheckBox x:Name="ArrowEndBox" Content="Arrow end" Margin="0,0,15,6"/>
                                <CheckBox x:Name="StatisticsBox" Content="Stats" Margin="0,0,15,6"/>
                                <CheckBox x:Name="AngleBox" Content="Angle" Margin="0,0,15,6"/>
                                <CheckBox x:Name="AlwaysStatsBox" Content="Always show stats" Margin="0,0,15,6"/>
                                <CheckBox x:Name="PlaceAsBackgroundBox" Content="Place as background (behind candles)" Margin="0,0,15,6"/>
                            </WrapPanel>

                            <Expander Grid.Row="6" Grid.ColumnSpan="2" Header="More" Margin="0,5,0,0" IsExpanded="False">
                                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Object name" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Column="1" Margin="0,3" Padding="7,4"/>
                                    <TextBlock Grid.Row="1" Text="Visual layer" VerticalAlignment="Center"/><ComboBox x:Name="VisualLayerBox" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                                    <TextBlock Grid.Row="2" Text="Synchronization" VerticalAlignment="Center"/><ComboBox x:Name="SyncModeBox" Grid.Row="2" Grid.Column="1" Margin="0,3"/>
                                </Grid>
                            </Expander>
                        </Grid>

                        <Border x:Name="PositionStyleSection" Visibility="Collapsed" Margin="0,12,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Position style"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Target color / fill" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                        <TextBox x:Name="PositionTargetColorBox" Visibility="Collapsed"/>
                                        <Button x:Name="PositionTargetColorButton" settings:ThemeColorScope.PreserveExactColors="True" Width="38" Height="29" MinHeight="29" Margin="0,0,8,0" Click="PositionTargetColorButton_Click" ToolTip="Target colour"/>
                                        <Slider x:Name="PositionTargetOpacitySlider" Width="150" Minimum="0" Maximum="1" TickFrequency="0.01" SmallChange="0.01" LargeChange="0.05" IsMoveToPointEnabled="True" IsSnapToTickEnabled="False" ToolTip="Target background transparency: 0 = transparent, 1 = solid"/>
                                        <TextBox x:Name="PositionTargetOpacityBox" Width="54" Margin="7,0,0,0" Padding="7,4"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Stop color / fill" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                        <TextBox x:Name="PositionStopColorBox" Visibility="Collapsed"/>
                                        <Button x:Name="PositionStopColorButton" settings:ThemeColorScope.PreserveExactColors="True" Width="38" Height="29" MinHeight="29" Margin="0,0,8,0" Click="PositionStopColorButton_Click" ToolTip="Stop colour"/>
                                        <Slider x:Name="PositionStopOpacitySlider" Width="150" Minimum="0" Maximum="1" TickFrequency="0.01" SmallChange="0.01" LargeChange="0.05" IsMoveToPointEnabled="True" IsSnapToTickEnabled="False" ToolTip="Stop background transparency: 0 = transparent, 1 = solid"/>
                                        <TextBox x:Name="PositionStopOpacityBox" Width="54" Margin="7,0,0,0" Padding="7,4"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Text="Text size" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PositionFontSizeBox" Grid.Row="2" Grid.Column="1" Width="72" HorizontalAlignment="Left" Margin="0,3" Padding="7,4" ToolTip="Position label text size"/>
                                    <TextBlock Grid.Row="3" Text="Stats" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="PositionStatsModeBox" Grid.Row="3" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,3"/>
                                    <WrapPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,7,0,0">
                                        <CheckBox x:Name="PositionPriceLabelsBox" Content="Price labels" Margin="0,0,18,0"/>
                                        <CheckBox x:Name="PositionCompactStatsBox" Content="Compact stats mode"/>
                                    </WrapPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="VolumeProfileStyleSection" Visibility="Collapsed" Margin="0,12,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Volume profile style"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,2,0,5">
                                        <CheckBox x:Name="VpShowProfileBox" Content="Volume profile" Margin="0,0,18,0"/>
                                        <CheckBox x:Name="VpShowValuesBox" Content="Values" Margin="0,0,8,0"/>
                                        <Button x:Name="VpValuesColor" settings:ThemeColorScope.PreserveExactColors="True" Width="36" Height="25" Click="VolumeProfileValuesColorButton_Click" ToolTip="Values colour"/>
                                    </WrapPanel>
                                    <TextBlock Grid.Row="1" Text="Values transparency" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                        <Slider x:Name="VpValuesOpacity" Width="150" Minimum="0" Maximum="1" TickFrequency="0.01" IsMoveToPointEnabled="True"/>
                                        <TextBox x:Name="VpValuesOpacityBox" Width="54" Margin="7,0,0,0" Padding="7,4"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Text="Width (% of box)" VerticalAlignment="Center"/>
                                    <TextBox x:Name="VpWidthBox" Grid.Row="2" Grid.Column="1" Width="88" HorizontalAlignment="Left" Margin="0,3" Padding="7,4"/>
                                    <TextBlock Grid.Row="3" Text="Placement" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="VpPlacementBox" Grid.Row="3" Grid.Column="1" Width="130" HorizontalAlignment="Left" Margin="0,3"/>
                                </Grid>

                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,6" Text="Each colour has its own transparency: 0 = transparent, 1 = solid."/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="132"/><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox x:Name="VpUpEnabled" Grid.Row="0" VerticalAlignment="Center"/><TextBlock Grid.Row="0" Grid.Column="1" Text="Up Volume" VerticalAlignment="Center"/><Button x:Name="VpUpColor" Tag="Up Volume" Grid.Row="0" Grid.Column="2" Height="25" Margin="2" Click="VolumeProfileColorButton_Click"/><Slider x:Name="VpUpOpacity" Grid.Row="0" Grid.Column="3" Minimum="0" Maximum="1" TickFrequency="0.01" IsMoveToPointEnabled="True"/><TextBox x:Name="VpUpOpacityBox" Grid.Row="0" Grid.Column="4" Margin="4,2" Padding="4,2"/>
                                    <CheckBox x:Name="VpDownEnabled" Grid.Row="1" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="1" Text="Down Volume" VerticalAlignment="Center"/><Button x:Name="VpDownColor" Tag="Down Volume" Grid.Row="1" Grid.Column="2" Height="25" Margin="2" Click="VolumeProfileColorButton_Click"/><Slider x:Name="VpDownOpacity" Grid.Row="1" Grid.Column="3" Minimum="0" Maximum="1" TickFrequency="0.01" IsMoveToPointEnabled="True"/><TextBox x:Name="VpDownOpacityBox" Grid.Row="1" Grid.Column="4" Margin="4,2" Padding="4,2"/>
                                    <CheckBox x:Name="VpValueUpEnabled" Grid.Row="2" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="1" Text="Value Area Up" VerticalAlignment="Center"/><Button x:Name="VpValueUpColor" Tag="Value Area Up" Grid.Row="2" Grid.Column="2" Height="25" Margin="2" Click="VolumeProfileColorButton_Click"/><Slider x:Name="VpValueUpOpacity" Grid.Row="2" Grid.Column="3" Minimum="0" Maximum="1" TickFrequency="0.01" IsMoveToPointEnabled="True"/><TextBox x:Name="VpValueUpOpacityBox" Grid.Row="2" Grid.Column="4" Margin="4,2" Padding="4,2"/>
                                    <CheckBox x:Name="VpValueDownEnabled" Grid.Row="3" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Grid.Column="1" Text="Value Area Down" VerticalAlignment="Center"/><Button x:Name="VpValueDownColor" Tag="Value Area Down" Grid.Row="3" Grid.Column="2" Height="25" Margin="2" Click="VolumeProfileColorButton_Click"/><Slider x:Name="VpValueDownOpacity" Grid.Row="3" Grid.Column="3" Minimum="0" Maximum="1" TickFrequency="0.01" IsMoveToPointEnabled="True"/><TextBox x:Name="VpValueDownOpacityBox" Grid.Row="3" Grid.Column="4" Margin="4,2" Padding="4,2"/>
                                    <CheckBox x:Name="VpVahEnabled" Grid.Row="4" VerticalAlignment="Center"/><TextBlock Grid.Row="4" Grid.Column="1" Text="VAH" VerticalAlignment="Center"/><Button x:Name="VpVahColor" Tag="VAH" Grid.Row="4" Grid.Column="2" Height="25" Margin="2" Click="VolumeProfileColorButton_Click"/><Slider x:Name="VpVahOpacity" Grid.Row="4" Grid.Column="3" Minimum="0" Maximum="1" TickFrequency="0.01" IsMoveToPointEnabled="True"/><TextBox x:Name="VpVahOpacityBox" Grid.Row="4" Grid.Column="4" Margin="4,2" Padding="4,2"/>
                                    <CheckBox x:Name="VpValEnabled" Grid.Row="5" VerticalAlignment="Center"/><TextBlock Grid.Row="5" Grid.Column="1" Text="VAL" VerticalAlignment="Center"/><Button x:Name="VpValColor" Tag="VAL" Grid.Row="5" Grid.Column="2" Height="25" Margin="2" Click="VolumeProfileColorButton_Click"/><Slider x:Name="VpValOpacity" Grid.Row="5" Grid.Column="3" Minimum="0" Maximum="1" TickFrequency="0.01" IsMoveToPointEnabled="True"/><TextBox x:Name="VpValOpacityBox" Grid.Row="5" Grid.Column="4" Margin="4,2" Padding="4,2"/>
                                    <CheckBox x:Name="VpPocEnabled" Grid.Row="6" VerticalAlignment="Center"/><TextBlock Grid.Row="6" Grid.Column="1" Text="POC" VerticalAlignment="Center"/><Button x:Name="VpPocColor" Tag="POC" Grid.Row="6" Grid.Column="2" Height="25" Margin="2" Click="VolumeProfileColorButton_Click"/><Slider x:Name="VpPocOpacity" Grid.Row="6" Grid.Column="3" Minimum="0" Maximum="1" TickFrequency="0.01" IsMoveToPointEnabled="True"/><TextBox x:Name="VpPocOpacityBox" Grid.Row="6" Grid.Column="4" Margin="4,2" Padding="4,2"/>
                                    <CheckBox x:Name="VpDevelopingPocEnabled" Grid.Row="7" VerticalAlignment="Center"/><TextBlock Grid.Row="7" Grid.Column="1" Text="Developing POC" VerticalAlignment="Center"/><Button x:Name="VpDevelopingPocColor" Tag="Developing POC" Grid.Row="7" Grid.Column="2" Height="25" Margin="2" Click="VolumeProfileColorButton_Click"/><Slider x:Name="VpDevelopingPocOpacity" Grid.Row="7" Grid.Column="3" Minimum="0" Maximum="1" TickFrequency="0.01" IsMoveToPointEnabled="True"/><TextBox x:Name="VpDevelopingPocOpacityBox" Grid.Row="7" Grid.Column="4" Margin="4,2" Padding="4,2"/>
                                    <CheckBox x:Name="VpDevelopingVaEnabled" Grid.Row="8" VerticalAlignment="Center"/><TextBlock Grid.Row="8" Grid.Column="1" Text="Developing VA" VerticalAlignment="Center"/><Button x:Name="VpDevelopingVaColor" Tag="Developing VA" Grid.Row="8" Grid.Column="2" Height="25" Margin="2" Click="VolumeProfileColorButton_Click"/><Slider x:Name="VpDevelopingVaOpacity" Grid.Row="8" Grid.Column="3" Minimum="0" Maximum="1" TickFrequency="0.01" IsMoveToPointEnabled="True"/><TextBox x:Name="VpDevelopingVaOpacityBox" Grid.Row="8" Grid.Column="4" Margin="4,2" Padding="4,2"/>
                                    <CheckBox x:Name="VpHistogramEnabled" Grid.Row="9" VerticalAlignment="Center"/><TextBlock Grid.Row="9" Grid.Column="1" Text="Histogram Box" VerticalAlignment="Center"/><Button x:Name="VpHistogramColor" Tag="Histogram Box" Grid.Row="9" Grid.Column="2" Height="25" Margin="2" Click="VolumeProfileColorButton_Click"/><Slider x:Name="VpHistogramOpacity" Grid.Row="9" Grid.Column="3" Minimum="0" Maximum="1" TickFrequency="0.01" IsMoveToPointEnabled="True"/><TextBox x:Name="VpHistogramOpacityBox" Grid.Row="9" Grid.Column="4" Margin="4,2" Padding="4,2"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="LevelsSection" Margin="0,12,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,7">
                                    <TextBlock x:Name="LevelsTitleText" Style="{StaticResource SectionTitle}" Text="Levels" DockPanel.Dock="Left"/>
                                    <WrapPanel HorizontalAlignment="Right">
                                        <Button Style="{StaticResource CompactButton}" Content="+" ToolTip="Add level" Click="AddLevelButton_Click"/>
                                        <Button Style="{StaticResource CompactButton}" Content="−" ToolTip="Remove level" Click="RemoveLevelButton_Click"/>
                                        <Button Style="{StaticResource CompactButton}" Content="↑" ToolTip="Move up" Click="MoveLevelUpButton_Click"/>
                                        <Button Style="{StaticResource CompactButton}" Content="↓" ToolTip="Move down" Click="MoveLevelDownButton_Click"/>
                                        <Button Style="{StaticResource CompactButton}" Content="Line colour" Click="LevelColorButton_Click"/>
                                        <Button Style="{StaticResource CompactButton}" Content="Zone colour" Click="LevelFillColorButton_Click"/>
                                        <Button Style="{StaticResource CompactButton}" Content="Defaults" Click="ResetLevelsButton_Click"/>
                                    </WrapPanel>
                                </DockPanel>
                                <DataGrid x:Name="LevelsGrid" Height="220" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" RowHeight="29" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="40"/>
                                        <DataGridTextColumn Header="Level" Binding="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                                        <DataGridTextColumn Header="Label" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTemplateColumn Header="Line" Width="54"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="31" Height="16" CornerRadius="2" BorderBrush="#777777" BorderThickness="1" HorizontalAlignment="Center" Background="{Binding Color, Converter={StaticResource ColorValueToBrushConverter}}" ToolTip="{Binding Color, Converter={StaticResource ColorValueToNameConverter}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Zone" Width="54"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="31" Height="16" CornerRadius="2" BorderBrush="#777777" BorderThickness="1" HorizontalAlignment="Center" Background="{Binding FillColor, Converter={StaticResource ColorValueToBrushConverter}}" ToolTip="{Binding FillColor, Converter={StaticResource ColorValueToNameConverter}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Fill" Binding="{Binding FillOpacityText, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                                        <DataGridTextColumn Header="Width" Binding="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                                        <DataGridTextColumn Header="Style" Binding="{Binding LineStyleText, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                        <DataGridCheckBoxColumn Header="$" Binding="{Binding ShowPrice}" Width="38"/>
                                        <DataGridCheckBoxColumn Header="%" Binding="{Binding ShowValue}" Width="38"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="TextLabelsTab" Header="Text">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Text"/><TextBox x:Name="DrawingTextBox" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,9" Padding="8"/>
                    <TextBlock Grid.Row="1" Text="Font" VerticalAlignment="Center"/><TextBox x:Name="FontFamilyBox" Grid.Row="1" Grid.Column="1" Margin="0,3" Padding="7,4"/>
                    <TextBlock Grid.Row="2" Text="Size" VerticalAlignment="Center"/><TextBox x:Name="FontSizeBox" Grid.Row="2" Grid.Column="1" Margin="0,3" Padding="7,4"/>
                    <TextBlock Grid.Row="3" Text="Background" VerticalAlignment="Center"/>
                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="0"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBox x:Name="BackgroundColorBox" Visibility="Collapsed"/><Button x:Name="BackgroundColorButton" settings:ThemeColorScope.PreserveExactColors="True" Grid.Column="1" Height="29" MinHeight="29" Click="BackgroundColorButton_Click" ToolTip="Text background"/></Grid>
                    <WrapPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0"><CheckBox x:Name="BoldBox" Content="Bold" Margin="0,0,20,0"/><CheckBox x:Name="ItalicBox" Content="Italic"/></WrapPanel>
                    <TextBlock Grid.Row="5" Text="Horizontal align" VerticalAlignment="Center"/><ComboBox x:Name="HorizontalAlignmentBox" Grid.Row="5" Grid.Column="1" Margin="0,3"/>
                    <TextBlock Grid.Row="6" Text="Vertical align" VerticalAlignment="Center"/><ComboBox x:Name="VerticalAlignmentBox" Grid.Row="6" Grid.Column="1" Margin="0,3"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="InputsTab" Header="Inputs">
                <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="OptionsIntroText" Text="Tool-specific inputs" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8"/>
                    <DataGrid x:Name="OptionsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" RowHeight="30">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Input" Binding="{Binding Name}" IsReadOnly="True" Width="150"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Width="86"/>
                            <DataGridTextColumn Header="Meaning" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="VolumeProfileInputsPanel" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Rows Layout" VerticalAlignment="Center"/><ComboBox x:Name="VpRowsLayoutBox" Grid.Row="0" Grid.Column="1" Margin="0,5"/>
                            <TextBlock Grid.Row="1" Text="Row Size" VerticalAlignment="Center"/><TextBox x:Name="VpRowSizeBox" Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,5" Padding="7,4"/>
                            <TextBlock Grid.Row="2" Text="Volume" VerticalAlignment="Center"/><ComboBox x:Name="VpVolumeModeBox" Grid.Row="2" Grid.Column="1" Margin="0,5"/>
                            <TextBlock Grid.Row="3" Text="Value Area Volume" VerticalAlignment="Center"/><TextBox x:Name="VpValueAreaBox" Grid.Row="3" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,5" Padding="7,4"/>
                            <CheckBox x:Name="VpExtendRightBox" Grid.Row="4" Grid.ColumnSpan="2" Content="Extend Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="CoordinatesTab" Header="Coordinates">
                <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="CoordinatesIntroText" Text="Exact date, time and price for every anchor." Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8"/>
                    <DataGrid x:Name="CoordinatesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" RowHeight="30">
                        <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="42"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" Width="132"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" Width="112"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="VolumeProfileCoordinatesPanel" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
                        <TextBlock Text="Range coordinates" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="#1 (bar)" VerticalAlignment="Center"/>
                            <TextBox x:Name="VpCoordinate1Box" Grid.Row="0" Grid.Column="1" Margin="0,5" Padding="7,4"/>
                            <Grid x:Name="VpCoordinate2Row" Grid.Row="1" Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                <TextBlock Text="#2 (bar)" VerticalAlignment="Center"/>
                                <TextBox x:Name="VpCoordinate2Box" Grid.Column="1" Margin="0,5" Padding="7,4"/>
                            </Grid>
                        </Grid>
                        <TextBlock Text="Bar numbers use the currently loaded chart data; TickLab keeps the saved drawing anchored by timestamp." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="VisibilityTab" Header="Visibility">
                <Grid Margin="19"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Visible on intervals"/><CheckBox x:Name="SecondsBox" Content="Seconds" Margin="0,3"/><CheckBox x:Name="MinutesBox" Content="Minutes" Margin="0,3"/><CheckBox x:Name="HoursBox" Content="Hours" Margin="0,3"/><CheckBox x:Name="DailyBox" Content="Days" Margin="0,3"/><CheckBox x:Name="WeeklyBox" Content="Weeks" Margin="0,3"/><CheckBox x:Name="MonthlyBox" Content="Months" Margin="0,3"/>
                        <TextBlock Margin="0,15,0,4" Text="Minimum interval"/><TextBox x:Name="MinimumTimeframeBox" Margin="0,0,17,6" Padding="7,4"/><TextBlock Text="Maximum interval"/><TextBox x:Name="MaximumTimeframeBox" Margin="0,4,17,0" Padding="7,4"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource SectionTitle}" Text="Object"/><CheckBox x:Name="LockedBox" Content="Locked" Margin="0,3"/><CheckBox x:Name="HiddenBox" Content="Hidden" Margin="0,3"/></StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="9,6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Template" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,6,0"/>
                    <ComboBox x:Name="ExistingTemplatesBox" DisplayMemberPath="Name" Width="132" Height="29" MinHeight="29"/>
                    <Button Style="{StaticResource CompactButton}" Content="Apply" Margin="5,0,0,0" Click="ApplyTemplateButton_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CompactButton}" Content="Cancel" Click="CancelButton_Click"/>
                    <Button Style="{StaticResource CompactButton}" Content="OK" FontWeight="SemiBold" Background="{DynamicResource AccentSoftBrush}" Click="ApplyButton_Click"/>
                </StackPanel>
                <!-- Template save/manage state remains available through the selected-object template menu. -->
                <Grid Visibility="Collapsed">
                    <TextBox x:Name="TemplateNameBox"/><CheckBox x:Name="SaveTemplateBox"/><CheckBox x:Name="DefaultTemplateBox"/>
                    <Button Click="SetDefaultTemplateButton_Click"/><Button Click="DeleteTemplateButton_Click"/><Button Click="DefaultsButton_Click"/><Button Click="ResetDrawingButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
