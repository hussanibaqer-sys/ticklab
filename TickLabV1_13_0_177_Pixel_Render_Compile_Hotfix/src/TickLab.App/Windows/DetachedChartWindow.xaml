<Window x:Class="TickLab.Desktop.Windows.DetachedChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TickLab.Desktop.Controls"
        Title="TickLab Chart"
        Width="980" Height="620" MinWidth="420" MinHeight="260"
        WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True" Background="#050505"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="CompactCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="24"/><Setter Property="Height" Value="22"/><Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="#C0C0C0"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}" CornerRadius="4" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="#222222"/><Setter Property="Foreground" Value="White"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="#2E2E2E"/><Setter TargetName="CaptionSurface" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactCloseButton" TargetType="Button" BasedOn="{StaticResource CompactCaptionButton}">
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C43A50"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#3A3A3A" BorderThickness="1" Background="#050505">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="31"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="WindowDragBar" Grid.Row="0" Background="#080808" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="WindowDragBar_MouseLeftButtonDown" MouseRightButtonUp="WindowDragBar_MouseRightButtonUp">
                <Grid Margin="7,0,3,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ChartNumberBadge" Width="21" Height="21" CornerRadius="4" Background="#1C1C1C" BorderBrush="#5A5A5A" BorderThickness="1"
                            VerticalAlignment="Center" Cursor="Hand" ToolTip="Drag this chart number onto a workspace partition"
                            PreviewMouseLeftButtonDown="ChartNumberBadge_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ChartNumberBadge_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="ChartNumberBadge_PreviewMouseLeftButtonUp">
                        <TextBlock x:Name="ChartNumberText" Text="2" Foreground="White" FontSize="10.5" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="ChartDragGrip" Grid.Column="1" Width="132" Height="23" CornerRadius="4" Background="#21456F"
                            BorderBrush="#84B8EE" BorderThickness="1" VerticalAlignment="Center" Margin="4,0,0,0" Cursor="SizeAll"
                            ToolTip="Hold and drag this complete free chart into a workspace partition"
                            PreviewMouseLeftButtonDown="ChartNumberBadge_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ChartNumberBadge_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="ChartNumberBadge_PreviewMouseLeftButtonUp">
                        <TextBlock Text="⠿  MOVE TO WORKSPACE" Foreground="White" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="ChartSymbolText" Grid.Column="2" Text="Chart" Foreground="#EAEAEA" FontWeight="SemiBold"
                               FontSize="11" VerticalAlignment="Center" Margin="7,0,0,0"/>
                    <TextBlock x:Name="ChartTimeframeText" Grid.Column="3" Text="" Foreground="#A0A0A0" FontSize="10"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Style="{StaticResource CompactCaptionButton}" Content="⋮" ToolTip="Attach, detach or make workspace" Click="WindowMenuButton_Click"/>
                        <Button Style="{StaticResource CompactCaptionButton}" Content="−" ToolTip="Minimize this chart" Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CompactCaptionButton}" Content="▢" ToolTip="Maximize or restore this chart" Click="MaximizeButton_Click"/>
                        <Button Style="{StaticResource CompactCloseButton}" Content="×" ToolTip="Close this chart" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="#050505">
                <controls:CandleChartControl x:Name="DetachedChart"/>
                <ContentControl x:Name="HostedContent" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
