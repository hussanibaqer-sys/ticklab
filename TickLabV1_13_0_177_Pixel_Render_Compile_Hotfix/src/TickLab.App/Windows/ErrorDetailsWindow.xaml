<Window x:Class="TickLab.Desktop.Windows.ErrorDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TickLab error"
        Width="720"
        Height="690"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#0B0B0B"
        Foreground="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="SeverityText" Text="ERROR" Foreground="#FCA5A5" FontSize="12" FontWeight="Bold"/>
                <TextBlock x:Name="TitleText" Text="Operation failed" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBlock x:Name="ErrorCodeText" Foreground="#93C5FD" FontFamily="Consolas" Margin="0,6,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="TickLab Error Engine" Foreground="#94A3B8" VerticalAlignment="Top"/>
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,0" Padding="15" Background="#2A1518" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Exact error" Foreground="#FCA5A5" FontWeight="Bold"/>
                <TextBlock x:Name="MessageText" Margin="0,7,0,0" FontSize="15" LineHeight="21"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="15" Background="#102419" BorderBrush="#245C3A" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Recommended action" Foreground="#86EFAC" FontWeight="Bold"/>
                <TextBlock x:Name="ActionText" Margin="0,7,0,0" Foreground="#D1FAE5"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,12,0,14" Padding="12" Background="#151515" BorderBrush="#353535" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Diagnostics" Foreground="#94A3B8" FontWeight="Bold" Margin="3,0,0,8"/>
                <TextBox x:Name="DiagnosticsBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Foreground="#E2E8F0"
                         Background="#080D16"
                         BorderBrush="#353535"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal">
                <Button Content="Copy Diagnostics" Click="CopyButton_Click"/>
                <Button Content="Open Log Folder" Click="OpenLogsButton_Click"/>
            </StackPanel>
            <Button Content="Close" HorizontalAlignment="Right" Background="#2563EB" BorderBrush="#3B82F6" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
