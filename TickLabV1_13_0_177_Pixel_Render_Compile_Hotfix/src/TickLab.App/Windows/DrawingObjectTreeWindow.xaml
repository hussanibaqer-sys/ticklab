<Window x:Class="TickLab.Desktop.Windows.DrawingObjectTreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TickLab Object Tree" Width="760" Height="560" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" ToolTip="Search drawings" TextChanged="SearchBox_TextChanged"/>
            <Button Grid.Column="1" Content="Refresh" Click="RefreshButton_Click" Margin="8,0,0,0"/>
        </Grid>
        <DataGrid x:Name="ObjectsGrid" Grid.Row="1" AutoGenerateColumns="False" SelectionMode="Extended" SelectionChanged="ObjectsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Tool" Binding="{Binding Tool}" Width="170"/>
                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="100"/>
                <DataGridCheckBoxColumn Header="Visible" Binding="{Binding Visible}" Width="70"/>
                <DataGridCheckBoxColumn Header="Locked" Binding="{Binding Locked}" Width="70"/>
                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Show/Hide" Click="ShowHideButton_Click"/>
            <Button Content="Lock/Unlock" Click="LockButton_Click"/>
            <Button Content="Front" Click="FrontButton_Click"/>
            <Button Content="Back" Click="BackButton_Click"/>
            <Button Content="Settings" Click="SettingsButton_Click"/>
            <Button Style="{StaticResource DangerButton}" Content="Remove" Click="RemoveButton_Click"/>
        </WrapPanel>
    </Grid>
</Window>
