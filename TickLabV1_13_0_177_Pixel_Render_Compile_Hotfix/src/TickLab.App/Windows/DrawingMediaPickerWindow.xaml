<Window x:Class="TickLab.Desktop.Windows.DrawingMediaPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TickLab.Desktop.Windows"
        Title="Drawing media" Width="560" Height="700" MinWidth="420" MinHeight="300"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource WindowBrush}"
        Deactivated="Window_Deactivated" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <local:EmojiPreviewConverter x:Key="EmojiPreviewConverter"/>
    </Window.Resources>
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="EmojiCategoryRow" Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Category strip from the reference picker.  Each button switches the virtualized list to that category without eagerly
                 constructing preview controls for the rest of the Unicode catalog. -->
            <Border x:Name="EmojiCategoryHost" Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                        <StackPanel x:Name="EmojiCategoryButtonsPanel" Orientation="Horizontal" Margin="8,5,4,4"/>
                    </ScrollViewer>
                    <Button Grid.Column="1" Width="28" Height="28" MinHeight="28" Padding="0" Margin="0,0,4,0"
                            Content="×" FontSize="17" VerticalAlignment="Center"
                            Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource MutedTextBrush}"
                            ToolTip="Close" Click="CancelButton_Click"/>
                </Grid>
            </Border>

            <TabControl x:Name="MediaTabs" Grid.Row="1" Margin="0" Padding="0"
                        TabStripPlacement="Bottom" SelectionChanged="MediaTabs_SelectionChanged">
                <TabControl.Resources>
                    <!-- The toolbar already has separate Emoji / Sticker / Icon entries.
                         Do not duplicate those as large bottom tabs inside the picker. -->
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Height" Value="0"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="Emojis" Tag="emojis">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Kept hidden for compatibility with keyboard/search plumbing; the
                             reference panel itself intentionally has no permanent search row. -->
                        <TextBox x:Name="MediaSearchBox" Visibility="Collapsed" TextChanged="MediaSearchBox_TextChanged"/>
                        <TextBlock x:Name="MediaCountText" Visibility="Collapsed"/>

                        <TextBlock x:Name="EmojiCurrentCategoryHeading" Grid.Row="0"
                                   Margin="18,11,12,7" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <!-- Virtualized rows: only on-screen emoji previews are constructed.
                             This keeps the full Unicode catalog without paying the cost of
                             ~4,000 full-colour vector controls every time the picker opens. -->
                        <ListBox x:Name="EmojiRowsList" Grid.Row="1" Margin="10,0,8,8"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 SelectionMode="Single">
                            <ListBox.Resources>
                                <!-- Match the stable scrollbar used by the History Report: a full-width
                                     native WPF scrollbar with a solid track/thumb that remains easy to grab. -->
                                <Style TargetType="{x:Type ScrollBar}">
                                    <Setter Property="Width" Value="15"/>
                                    <Setter Property="MinWidth" Value="15"/>
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Background" Value="#262A30"/>
                                    <Setter Property="Foreground" Value="#8491A0"/>
                                </Style>
                            </ListBox.Resources>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="52" Height="48" MinHeight="48"
                                                        Margin="1" Padding="0" Tag="{Binding}"
                                                        ToolTip="{Binding Label}"
                                                        Background="Transparent" BorderBrush="Transparent"
                                                        BorderThickness="0" Click="MediaButton_Click">
                                                    <Image Width="34" Height="34" Stretch="Uniform"
                                                           SnapsToDevicePixels="True"
                                                           Source="{Binding Mark, Converter={StaticResource EmojiPreviewConverter}}"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Stickers" Tag="stickers">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <WrapPanel x:Name="StickersPanel" Margin="12"/>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Icons" Tag="icons">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <WrapPanel x:Name="IconsPanel" Margin="12"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
