<Window x:Class="TickLab.Desktop.Windows.TickScriptHelpWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TickScript Help and Examples" Width="820" Height="650" WindowStartupLocation="CenterOwner" Background="#0B0B0B" Foreground="White" ShowInTaskbar="False">
<Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="TickScript 1.1 Guide" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Choose a script type in the editor. New selected type creates a ready-to-compile template." Foreground="#BDBDBD" Margin="0,4,0,10"/></StackPanel><TabControl Grid.Row="1"><TabItem Header="Quick start"><TextBox IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#070707" Foreground="#E8EEF8" Text="1. Choose Indicator, Strategy, EA, Scanner, Alert, Drawing Tool, Custom Chart, Library or Data Tool.&#10;2. Click New selected type.&#10;3. Edit the template.&#10;4. Press F5 or Compile &amp; Save.&#10;5. Compiled indicators appear under the Indicators button on the main top bar.&#10;6. Click Apply or drag the indicator onto the chart.&#10;&#10;Strategies and EAs are simulation/backtesting only and cannot place live trades."/></TabItem><TabItem Header="RSI example"><TextBox IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" Background="#070707" Foreground="#E8EEF8" Text="indicator(&quot;RSI Test&quot;, overlay=false)&#10;&#10;length = input.int(14, &quot;RSI Length&quot;)&#10;rsiValue = rsi(close, length)&#10;plot(rsiValue, &quot;RSI&quot;)&#10;hline(70, &quot;Overbought&quot;)&#10;hline(30, &quot;Oversold&quot;)"/></TabItem><TabItem Header="Functions"><TextBox IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#070707" Foreground="#E8EEF8" Text="Inputs: input.int, input.float, input.bool, input.string, input.source&#10;&#10;Indicators: sma, ema, rma, wma, vwma, rsi, atr, stdev, highest, lowest, change, roc, momentum&#10;&#10;Signals: crossover, crossunder, rising, falling&#10;&#10;Drawing: plot, plotshape, plotchar, hline, barcolor, bgcolor, fill&#10;&#10;Strategies: strategy.entry, strategy.exit, strategy.close, strategy.order&#10;&#10;Other: alert, alertcondition, scan.result, drawing.line, chart.candle, data.output"/></TabItem></TabControl><Button Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="16,7" Content="Close" Click="CloseButton_Click"/></Grid></Window>
